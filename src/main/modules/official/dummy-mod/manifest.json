{
    "id": "dummy-mod",
    "name": "Dummy Mod",
    "description": "V-Manager manifest modül sistemini test etmek için örnek mod.",
    "author": "vuenxx",
    "version": "0.1.0",

    "source": {
        "type": "github",
        "repo": "vuenxx/dummy",
        "release": "latest",
        "asset": "dummy-mod*.zip",
        "maxReleases": 10
    },

    "install": {
        "destination": "game_exe",
        "extractRoot": "auto",
        "files": {
            "exclude": ["README*", "LICENSE*"]
        }
    },

    "config": [
        {
            "file": "dummy-config.ini",
            "format": "ini",
            "search": ["dummy-config.ini", "Dummy-Config.ini"],
            "required": false,
            "set": {
                "DummySection.TestSetting": "enabled",
                "DummySection.Version": "0.1"
            }
        }
    ],

    "backup": {
        "enabled": false
    },

    "state": {
        "flag": "hasDummyMod",
        "versionField": "dummyModVersion"
    },

    "uninstall": {
        "files": [
            "dummy-config.ini",
            "dummy-mod-file.asi",
            "dummy-folder"
        ],
        "restoreBackup": false,
        "resetState": true
    },

    "permissions": ["internet", "game_files"],

    "metadata": {
        "homepage": "https://github.com/vuenxx/dummy",
        "tags": ["test", "dummy"]
    }
}
